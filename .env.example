# 1. Company Information
COMPANY_EMAIL=support@ashivox.com
COMPANY_PHONE=+1 (505) 393-1890

# 2. SMTP Mail Server Configuration
# Provide your SMTP credentials below to deliver real commercial invoices and inquiry alerts.
# Example Providers:
#   Gmail:           host: smtp.gmail.com        port: 465 or 587 (use 16-character App Password)
#   Namecheap/Titan: host: mail.privateemail.com port: 465 (SSL)
#   Zoho Mail:       host: smtppro.zoho.com      port: 465 (SSL)
#   Brevo / SendGrid: host: smtp-relay.brevo.com port: 587

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@ashivox.com
SMTP_PASS=your-smtp-app-password-here
SMTP_FROM="ASHIVOX LLC" <support@ashivox.com>


